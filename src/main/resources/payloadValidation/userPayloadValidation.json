{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "userId": {
            "type": "string",
            "prefix": "user-",
            "key": "Primary",
            "keyLength": 12,
            "description": "Auto-generated primary key (user-<12 digits>)"
        },
        "firstName": {
            "type": "string",
            "description": "Given name"
        },
        "lastName": {
            "type": "string",
            "description": "Family name"
        },
        "email": {
            "type": "string",
            "description": "Email address"
        },
        "phoneNumber": {
            "type": "string",
            "description": "Contact phone number"
        },
        "orgId": {
            "type": "string",
            "description": "Organisation id this user belongs to (org catalogue reference)"
        },
        "entityType": {
            "type": "string",
            "description": "User category; free string validated against the shared reference list at the caller layer"
        },
        "password": {
            "type": "string",
            "description": "Hashed password (hashed by the portal backend before submission; source of truth)"
        },
        "pin": {
            "type": "string",
            "description": "Hashed PIN (hashed by the portal backend before submission; source of truth)"
        },
        "passwordExpiresOn": {
            "type": "string",
            "description": "ISO-8601 date-time the password expires"
        },
        "pinExpiresOn": {
            "type": "string",
            "description": "ISO-8601 date-time the PIN expires"
        },
        "createdBy": {
            "type": "string",
            "description": "User id of the creator (set by the portal/auth layer)"
        },
        "updatedBy": {
            "type": "string",
            "description": "User id of the last updater (set by the portal/auth layer)"
        }
    },
    "required": [
        "firstName",
        "lastName",
        "email",
        "orgId",
        "entityType",
        "password"
    ]
}
